{
  "name": "himbazaar",
  "version": "0.1.0",
  "private": true,
  "description": "HimBazaar — India's marketplace for authentic Himalayan & Himachali products",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
