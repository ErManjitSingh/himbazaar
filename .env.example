# HimBazaar — environment template
# Copy to apps/web/.env.local for local development.
# NEVER commit real secrets.

# Public site URL (SEO / canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Future API base (mock services ignore this until backend is live)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Analytics (leave empty until configured)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Payment (server-only — never expose to client)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
